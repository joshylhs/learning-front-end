body {
  background-color:pink;
  font-family:helvetica;
}

figure {
  padding:0 auto;
  margin:0 auto;
  display:flex;
  flex-direction:column;
  align-items:center;
}

.divider {
  border-bottom: 1px solid black;
  height:0px;
  width:90%;
}

img {
  max-width:100%;
  display:block;
  margin:1rem;
  border-radius:50px;

}

main {
  background-color:beige;
  width:90%;
  margin:0 auto;
  padding:1rem;
  display:flex;
  flex-flow: column wrap;
  align-items:center;
    border-radius:40px
}

p:not(#tribute-info) {
  text-align:justify;
  text-indent:4rem;
  margin:1rem;
  line-height:1.5rem;
}

#tribute-info {
  text-align:center;
  font-weight:bold;
}
